{
  "env": {
    "CARGO_TERM_COLOR": "always",
    "RETRIES": 3
  },
  "jobs": {
    "test": {
      "runs-on": "${{ matrix.os }}",
      "steps": [
        {
          "uses": "actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955",
          "with": {
            "persist-credentials": false
          }
        },
        {
          "name": "Test",
          "run": "cargo test --locked\necho \"done: $(date)\" | tee -a \"$GITHUB_STEP_SUMMARY\"\n"
        },
        {
          "if": "github.event_name == 'push'",
          "name": "Folded",
          "run": "curl -fsSL https://example.com/install.sh | sh\n"
        }
      ],
      "strategy": {
        "fail-fast": false,
        "matrix": {
          "os": [
            "ubuntu-latest",
            "macos-latest",
            "windows-latest"
          ],
          "rust": [
            "1.100",
            "stable"
          ]
        }
      },
      "timeout-minutes": 30
    }
  },
  "name": "CI",
  "permissions": {
    "contents": "read"
  },
  "true": {
    "pull_request": null,
    "push": {
      "branches": [
        "main"
      ]
    },
    "workflow_dispatch": {
      "inputs": {
        "debug": {
          "default": false,
          "type": "boolean"
        }
      }
    }
  }
}
