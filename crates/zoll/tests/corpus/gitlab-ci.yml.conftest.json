{
  ".defaults": {
    "before_script": [
      "apk add --no-cache curl"
    ],
    "image": "alpine:3.20"
  },
  "build": {
    "before_script": [
      "apk add --no-cache curl"
    ],
    "image": "alpine:3.20",
    "only": [
      "main"
    ],
    "script": [
      "make build"
    ],
    "stage": "build"
  },
  "stages": [
    "build",
    "test"
  ],
  "test": {
    "allow_failure": true,
    "before_script": [
      "apk add --no-cache curl"
    ],
    "image": "alpine:3.20",
    "retry": 2,
    "script": [
      "make test"
    ],
    "stage": "test"
  }
}
